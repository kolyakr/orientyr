# only the project's own data/ at the repo root (see data/README.md), not any nested "data" dir elsewhere
/data/*
!/data/README.md
outputs/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.pt
*.pth
__pycache__/
*.egg-info/
build/
.venv/
.DS_Store

# docs live in the make-docs library "orientyr", not in git
docs/
extras/
make-docs.toml
*.pdf

# never commit data: imagery, rasters, arrays, archives, model weights
experiments/**/*.jpg
experiments/**/*.jpeg
experiments/**/*.png
*.tif
*.tiff
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.zip
*.tar*
*.onnx
*.ckpt
*.safetensors
*.bin
weights/
cache/

# full scan output (large, regenerable): only the committed results/candidates_summary.json survives
experiments/ukraine_scan/candidates.json
