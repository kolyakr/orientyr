experiments/**/*.jpg
experiments/**/*.jpeg
experiments/**/*.png
*.tif
*.tiff
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.zip
*.tar*
*.onnx
*.ckpt
*.safetensors
*.bin
weights/
cache/

